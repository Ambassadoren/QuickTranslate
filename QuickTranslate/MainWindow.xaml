<Window x:Class="QuickTranslate.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QuickTranslate — бесплатный переводчик" Width="560" Height="470"
 MinWidth="460" MinHeight="390" WindowStartupLocation="Manual"
 WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="16,12,16,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image Source="app.png" Width="24" Height="24" Margin="0,0,9,0"/>
    <TextBlock Text="QuickTranslate" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="● offline" Foreground="#70D7A8" FontSize="11" Margin="10,4,0,0" VerticalAlignment="Center"/>
   </StackPanel>
   <Button x:Name="ExpandButton" Grid.Column="1" Content="Развернуть" Click="Expand_Click" FontSize="11" Padding="9,6" Margin="0,0,6,0"/>
   <Button Grid.Column="2" Content="Настройки" Click="Settings_Click" FontSize="11" Padding="9,6"/>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="DirectionBox" SelectedIndex="0" SelectionChanged="Direction_Changed" MaxWidth="290" HorizontalAlignment="Left" MinWidth="210">
    <ComboBoxItem Content="Авто · Английский ↔ Русский"/><ComboBoxItem Content="Английский → Русский"/><ComboBoxItem Content="Русский → Английский"/>
   </ComboBox>
   <Button Grid.Column="1" Content="⇄" Click="Swap_Click" ToolTip="Поменять оригинал и перевод местами" Padding="9,5" Margin="6,0,0,0"/>
   <Button Grid.Column="2" Content="История" Click="History_Click" Margin="8,0,0,0"/>
  </Grid>
  <Grid x:Name="EditorsGrid" Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn1" Width="*"/><ColumnDefinition x:Name="EditorColumnGap" Width="0"/><ColumnDefinition x:Name="EditorColumn2" Width="0"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="SourceRow" Height="88"/><RowDefinition x:Name="EditorRowGap" Height="10"/><RowDefinition x:Name="ResultRow" Height="*"/></Grid.RowDefinitions>
   <Border x:Name="SourcePanel" Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="12,9">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,6"><TextBlock Text="ОРИГИНАЛ" FontSize="10" Foreground="#81899E" FontWeight="SemiBold"/><TextBlock x:Name="CharacterCount" Text="0 / 20 000" HorizontalAlignment="Right" FontSize="10" Foreground="#939BAF"/></Grid>
     <Grid Grid.Row="1">
      <TextBlock x:Name="SourcePlaceholder" Text="Выделите текст и нажмите Ctrl+C+C" Foreground="#9CA4B7" FontSize="14" IsHitTestVisible="False" TextWrapping="Wrap"/>
      <TextBox x:Name="SourceText" AutomationProperties.Name="Исходный текст" TextChanged="SourceText_Changed" MaxLength="20000" BorderThickness="0" Background="Transparent" Padding="0" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
     </Grid>
    </Grid>
   </Border>
   <Border x:Name="ResultPanel" Grid.Row="2" Background="{DynamicResource ResultBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="12,10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock x:Name="TargetLabel" Text="ПЕРЕВОД" FontSize="10" FontWeight="SemiBold" Foreground="#8776B2" Margin="0,0,0,7"/>
     <Grid Grid.Row="1"><TextBlock x:Name="ResultPlaceholder" Text="Здесь появится перевод" Foreground="#A196BB" FontSize="16" IsHitTestVisible="False"/><TextBox x:Name="ResultText" IsReadOnly="True" AutomationProperties.Name="Результат перевода" BorderThickness="0" Background="Transparent" Padding="0" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></Grid>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="3" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Content="Вставить" Click="Paste_Click" ToolTip="Текст или изображение из буфера" Padding="10,7" FontSize="12"/>
   <Button x:Name="ImageButton" Grid.Column="1" Content="Фото" Click="Image_Click" Padding="10,7" FontSize="12" Margin="5,0,0,0"/>
   <Button x:Name="CaptureButton" Grid.Column="2" Content="Область" Click="Capture_Click" Padding="10,7" FontSize="12" Margin="5,0,0,0"/>
   <Button x:Name="CopyButton" Grid.Column="4" Content="Копировать" Click="Copy_Click" Padding="10,7" FontSize="12" IsEnabled="False" Margin="5,0,5,0"/>
   <Button x:Name="TranslateButton" Grid.Column="5" Content="Перевести" Click="Translate_Click" Padding="12,7" FontSize="12" Background="#7156D9" Foreground="White" BorderThickness="0"/>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="4" Text="Ctrl+C+C · Esc — скрыть" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 </Grid>
</Window>
