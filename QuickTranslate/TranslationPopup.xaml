<Window x:Class="QuickTranslate.TranslationPopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QuickTranslate — перевод" Width="400" Height="154" MinWidth="320" MinHeight="130"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" FontFamily="Segoe UI" Style="{StaticResource {x:Type Window}}">
 <Border x:Name="PopupSurface" CornerRadius="10" Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="14,9,12,10">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,8" Background="Transparent" MouseLeftButtonDown="Header_Drag">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="app.png" Width="15" Height="15" Margin="0,0,7,0"/><TextBlock x:Name="DirectionLabel" Text="EN → RU" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
    <Button x:Name="CopyResultButton" Grid.Column="1" Click="Copy_Click" AutomationProperties.Name="Копировать перевод" ToolTip="Копировать перевод" Padding="5,4" BorderThickness="0" Background="Transparent" IsEnabled="False"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE8C8;"/></Button>
    <Button Grid.Column="2" Click="Editor_Click" AutomationProperties.Name="Открыть полный редактор" ToolTip="Открыть полный редактор" Padding="5,4" BorderThickness="0" Background="Transparent" Margin="4,0,4,0"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE8A7;"/></Button>
    <Button Grid.Column="3" Click="Hide_Click" AutomationProperties.Name="Скрыть перевод" ToolTip="Закрыть · Esc" Padding="5,4" BorderThickness="0" Background="Transparent"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8BB;"/></Button>
   </Grid>
   <TextBox x:Name="TranslationText" Grid.Row="1" AutomationProperties.Name="Всплывающий перевод" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
   <TextBlock x:Name="PopupStatus" Grid.Row="2" Text="Esc — скрыть" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Grid>
 </Border>
</Window>
