<Window x:Class="QuickTranslate.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuickTranslate"
 Title="Настройки QuickTranslate" Width="540" Height="650" MinWidth="480" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Настройки" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="0,0,10,0">
    <CheckBox x:Name="StartupBox" Content="Запускать с Windows — сразу в трей" Margin="0,0,0,7"/>
    <TextBlock x:Name="StartupNote" Text="Включайте после переноса в постоянную папку. После переноса включите автозапуск заново." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="23,0,0,18"/>
    <TextBlock Text="ПЕРЕВОД ТЕКСТА" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,0,9"/>
    <CheckBox x:Name="TextEnabledBox" Content="Включить горячую клавишу перевода" IsChecked="True" Margin="0,0,0,10"/>
    <ComboBox x:Name="TextModeBox" SelectedIndex="0" SelectionChanged="TextMode_Changed" Margin="0,0,0,9"><ComboBoxItem Content="Двойное копирование · Ctrl+C+C"/><ComboBoxItem Content="Своё сочетание · перевод буфера"/></ComboBox>
    <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Интервал нажатий:" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="IntervalBox" SelectedIndex="1" Width="125"><ComboBoxItem Content="350 мс"/><ComboBoxItem Content="650 мс"/><ComboBoxItem Content="1000 мс"/></ComboBox></StackPanel>
    <StackPanel x:Name="CustomTextPanel" Visibility="Collapsed" Margin="0,0,0,10">
     <local:ShortcutBox Style="{StaticResource {x:Type TextBox}}" x:Name="TextShortcutBox" AutomationProperties.Name="Сочетание для текста"/>
     <TextBlock Text="Нажмите сочетание в поле. Сначала скопируйте текст обычным Ctrl+C, затем вызовите перевод." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
    </StackPanel>
    <TextBlock Text="ОБЛАСТЬ ЭКРАНА" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" Margin="0,9,0,9"/>
    <CheckBox x:Name="CaptureEnabledBox" Content="Включить горячую клавишу снимка области" IsChecked="True" Margin="0,0,0,9"/>
    <local:ShortcutBox Style="{StaticResource {x:Type TextBox}}" x:Name="CaptureShortcutBox" AutomationProperties.Name="Сочетание для области"/>
    <TextBlock Text="Щёлкните поле и нажмите Ctrl или Alt вместе с нужной клавишей. Занятые сочетания будут проверены при сохранении." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,18"/>
    <TextBlock Text="ИСТОРИЯ" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,0,9"/>
    <CheckBox x:Name="HistoryEnabledBox" Content="Сохранять последние 50 переводов" IsChecked="True" Margin="0,0,0,7"/>
    <TextBlock Text="История и настройки находятся в папке Data рядом с запускным файлом. Отключение останавливает новые записи; очистка доступна в окне истории." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="23,0,0,12"/>
    <TextBlock Text="ЗАПИСЬ ДАННЫХ" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" Margin="0,8,0,9"/>
    <TextBlock Text="Используйте при ошибке доступа. Windows запросит подтверждение администратора. Запись разрешается вашему пользователю только в папку Data этого приложения." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,12"/>
   </StackPanel>
  </ScrollViewer>
  <TextBlock x:Name="ErrorText" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,12,0,8"/>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="RepairDataButton" Content="Разрешить запись в Data" Click="RepairData_Click" HorizontalAlignment="Left" FontSize="12" Padding="9,7"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Margin="8,0,8,0"/><Button x:Name="SaveButton" Content="Сохранить" Click="Save_Click" Background="#7156D9" Foreground="White" BorderThickness="0"/></StackPanel>
  </Grid>
 </Grid>
</Window>
